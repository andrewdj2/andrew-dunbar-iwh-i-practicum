html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    h1 Pets Custom Object Table
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Name
          th Species
          th Bio
      tbody
        each pet in pets
          tr
            td= pet.properties.name
            td= pet.properties.species
            td= pet.properties.bio
